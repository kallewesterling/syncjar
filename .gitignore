# app setup
.env
node_modules

# push's record of which courses were last verified in sync. Local by design:
# it describes this checkout's content against this Skilljar instance, and a
# missing file just means the next push scans everything.
.syncjar-push-state.json
.syncjar-quiz-state.json

# HTML data
public/courses
public/data

# Plaintext data
course-plaintext
courses-plaintext

# local sync folders
local-skilljar
local-skilljar-paths
local-skilljar-quizzes

# Preview theme config. Holds a real Skilljar domain and theme URLs, so it is
# local; copy preview.config.example.json to start one.
preview.config.json

# OS stuff
.DS_Store