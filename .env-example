# Settings that aren't secret. Keep SKILLJAR_API_KEY, SKILLJAR_CLIENT_ID and
# SKILLJAR_CLIENT_SECRET out of this file: store them in the macOS Keychain or
# a password manager instead (docs/configuration.md, "Keeping credentials in a
# password manager").
COURSE_CONTENT_PATH=../courses

# Comma-separated Skilljar domains to pull published-course slugs from.
# Required by scripts/pull-slugs.mjs unless you pass --domain.
SKILLJAR_DOMAINS=courses.example.com,example.skilljar.com
